# YourTube environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real secrets.

# ── Required ──

# Password for the parent admin panel and kid login.
# Change this to something strong before running.
YOURTUBE_PARENT_PASSWORD=changeme

# Stable session secret — any random string.
# If not set, a random one is generated on each start, which means users
# get logged out every restart. Generate one with: openssl rand -hex 32
YOURTUBE_SESSION_SECRET=replace-with-a-long-random-string

# ── Users ──

# Comma-separated list of kid usernames. Each user gets their own
# data/<username>/ directory for profile, channels, history, etc.
# Example: YOURTUBE_USERS=alice,bob,carol
YOURTUBE_USERS=kid

# Optional: separate password for kids. Defaults to YOURTUBE_PARENT_PASSWORD.
#YOURTUBE_KID_PASSWORD=

# ── Server ──

# Port and host. Defaults: 3457 / 0.0.0.0.
#YOURTUBE_PORT=3457
#YOURTUBE_HOST=0.0.0.0

# ── YouTube API (optional, for importing subscriptions/likes) ──

# Create an OAuth 2.0 Client ID in Google Cloud Console.
# See docs/setup/oauth.md for step-by-step instructions.
#YOURTUBE_YOUTUBE_CLIENT_ID=
#YOURTUBE_YOUTUBE_CLIENT_SECRET=

# ── AI content filter (optional) ──

# When true, YourTube uses the Claude CLI to classify videos against your
# taste profile. Requires `claude` to be installed and on PATH.
# Leave unset (or false) to disable AI filtering.
#YOURTUBE_AI_FILTER_ENABLED=true

# ── KidCode cross-app integration (optional) ──

# If you also run KidCode (a sibling project) and want kids to click through
# from KidCode to YourTube without re-entering a password, enable this and
# set a shared secret that matches KidCode's config.
# The URL is where the KidCode link button in the YourTube header points to.
#YOURTUBE_KIDCODE_ENABLED=true
#YOURTUBE_KIDCODE_URL=http://localhost:3456/
#KIDCODE_CROSS_AUTH_SECRET=long-random-string-shared-with-kidcode
